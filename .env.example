# ============================================================================
# Portfolio contact form — environment variables
# ----------------------------------------------------------------------------
# Copy this file to ".env.local" and fill in your details to enable email
# delivery from the contact form.
#
# Without these vars the form still validates and returns a friendly message,
# but no email is actually delivered.
# ============================================================================

# --- Recipient: where contact-form messages are sent TO (your inbox) ---
EMAIL_TO=abdullahabbasi852@gmail.com

# --- Option A: Gmail SMTP (requires 2FA + an App Password, NOT your password) ---
# Generate one at: https://myaccount.google.com/apppasswords
EMAIL_USER=abdullahabbasi852@gmail.com
EMAIL_PASS=kftbazolgfmphymx

# --- Option B: SendGrid (preferred for production) ---
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxx
# SENDGRID_FROM=abdullahabbasi852@gmail.com   # optional, defaults to EMAIL_USER
